{
  "name": "temp-init",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev --host",
    "dev:test": "vite --mode test --host",
    "dev:prod": "vite --mode prod --host",
    "build": "tsc -b && vite build --mode dev",
    "build:test": "tsc -b && vite build --mode test",
    "build:prod": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "comp:add": "npx shadcn@latest add",
    "setup:dev": "npm run sp:push && npm run sp:gen-types",
    "setup:test": "npm run sp:push:test && npm run sp:gen-types:test",
    "setup:prod": "npm run sp:push:prod && npm run sp:gen-types:prod",
    "sp:migrate": "npx supabase migration new",
    "sp:push": "cross-env ENV_FILE=.env.dev node scripts/migrate.mjs",
    "sp:push:test": "cross-env ENV_FILE=.env.test node scripts/migrate.mjs",
    "sp:push:prod": "cross-env ENV_FILE=.env.prod node scripts/migrate.mjs",
    "sp:status": "cross-env ENV_FILE=.env.dev node scripts/migrate-status.mjs",
    "sp:status:test": "cross-env ENV_FILE=.env.test node scripts/migrate-status.mjs",
    "sp:status:prod": "cross-env ENV_FILE=.env.prod node scripts/migrate-status.mjs",
    "sp:test": "cross-env ENV_FILE=.env.dev node scripts/migrate-test.mjs",
    "sp:test:test": "cross-env ENV_FILE=.env.test node scripts/migrate-test.mjs",
    "sp:test:prod": "cross-env ENV_FILE=.env.prod node scripts/migrate-test.mjs",
    "sp:schema": "cross-env ENV_FILE=.env.dev node scripts/migrate-schema.mjs",
    "sp:schema:test": "cross-env ENV_FILE=.env.test node scripts/migrate-schema.mjs",
    "sp:schema:prod": "cross-env ENV_FILE=.env.prod node scripts/migrate-schema.mjs",
    "sp:gen-types": "cross-env ENV_FILE=.env.dev node scripts/gen-types.mjs",
    "sp:gen-types:test": "cross-env ENV_FILE=.env.test node scripts/gen-types.mjs",
    "sp:gen-types:prod": "cross-env ENV_FILE=.env.prod node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "^2.89.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
